BASE_URL=http://<服务器IP>:<端口>
TEST_USERNAME=test01
TEST_PASSWORD=Test123456
# Day12：端到端认领流程的用户B（已审核账号；注册后需管理员审核才能登录）
E2E_USERNAME=test02
E2E_PASSWORD=Test123456
# 数据库经 SSH 隧道访问（服务器 MySQL 仅监听本机，远程直连不可行）：
#   1) 先开隧道（Windows 双击 start-db-tunnel.bat，或手动）：
#      ssh -N -L 13306:127.0.0.1:3306 root@<服务器IP>
#   2) DB_HOST 填 127.0.0.1，DB_PORT 填隧道本地端口 13306
#      （⚠️ 本机若装有 MySQL 会占用 3306，所以隧道必须用 13306）
# 不开隧道时数据库校验用例会跳过（学习模式），API 用例不受影响
DB_HOST=127.0.0.1
DB_PORT=13306
DB_USER=lost_found_user
DB_PASSWORD=xxx
DB_NAME=lost_found_db
